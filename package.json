{
  "name": "canyoning-topo-generator",
  "version": "1.0.0",
  "description": "Statischer Canyoning-Topo-Generator (HTML + SVG, GitHub-Pages-tauglich)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node tools/proxy.mjs",
    "proxy": "node tools/proxy.mjs",
    "serve": "python3 -m http.server 8080",
